ANTHROPIC_API_KEY=your_anthropic_api_key_here
FAL_KEY=your_fal_api_key_here
SERPAPI_KEY=your_serpapi_key_here
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# GitHub OAuth — gates the app behind sign-in so anonymous visitors/bots can't
# burn the API keys above. Register an OAuth App at
# https://github.com/settings/developers (a separate one for local dev vs.
# production is easiest, since each app has exactly one callback URL):
#   Homepage URL: CLIENT_ORIGIN above
#   Authorization callback URL: CLIENT_ORIGIN above + /api/auth/github/callback
# The callback deliberately points at the CLIENT's domain, not this server's
# own — client/vercel.json proxies /api/* through to this server, so the
# session cookie ends up first-party to whatever domain the browser is
# actually on. Without that, mobile browsers' cross-site cookie blocking
# will silently refuse to send it back on later API calls.
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
# Random string used to sign session cookies — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string

# Supabase — stores saved analyses (Postgres), keyed by GitHub login.
# Create a project at supabase.com, then run server/db/schema.sql once in its
# SQL Editor to create the table. Get these from Project Settings → API —
# SUPABASE_SERVICE_ROLE_KEY is the "service_role" secret key, NOT the public
# "anon" key (the service_role key bypasses Row Level Security, so it must
# never reach the client — server-side only).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
